# ==========================================================
# AI yapılandırması — bu dosyayı .env olarak kopyalayın
# (cp .env.example .env) ve değerleri doldurun.
# Anahtar boş bırakılırsa uygulama dahili akıllı motora düşer.
# ==========================================================

# Sağlayıcı: openai | openai-compatible | gemini | groq | openrouter
# (Boş bırakılırsa anahtarın önekinden otomatik anlaşılır.)
AI_PROVIDER=openai

# Birincil API anahtarı (OpenAI, Groq gsk_..., Gemini AIza..., OpenRouter sk-or-...)
AI_API_KEY=

# Kullanılacak model
AI_MODEL=gpt-4o-mini

# OpenAI-uyumlu endpoint tabanı (Ollama, LM Studio, vLLM, Together, Azure OpenAI...)
# OpenAI için: https://api.openai.com/v1
AI_BASE_URL=https://api.openai.com/v1

# LLM'e gönderilecek geçmiş mesaj penceresi (6-30 arası)
AI_HISTORY_LIMIT=16

# Alternatif sağlayıcı anahtarları (AI_API_KEY boşsa sırayla denenir)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Sunucu portu
PORT=5001
